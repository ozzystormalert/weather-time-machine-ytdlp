
"use strict";

/*
 WEATHER TIME MACHINE
 REUSABLE YOUTUBE GRADING ENGINE

 STEP 3: News Coverage of Weather Event
 STEP 4: Educational Documentaries (20+ minutes)

 Uses:
 - YouTube Data API v3
 - Search discovery
 - Official view counts
 - Official video duration
 - Duplicate removal
 - Event/location relevance screening
 - Category-specific relevance screening
 - JSON reports

 Node.js 22+
 No external npm packages.

 Required:
   YOUTUBE_API_KEY

 Optional:
   ENGINE_STEP=3 or 4
   WEATHER_EVENT="Hurricane Sandy"
   WEATHER_YEAR=2012
   WEATHER_LOCATION="New Jersey"
   MIN_VIEWS=1000
   MIN_DOCUMENTARY_MINUTES=20
   MAX_RESULTS_PER_QUERY=50
   MAX_PAGES_PER_QUERY=1
   MAX_SEARCH_CALLS=20

 Example:
   ENGINE_STEP=4
   WEATHER_EVENT="Hurricane Sandy"
   WEATHER_YEAR=2012
   WEATHER_LOCATION="New Jersey"

 A-F grade thresholds are configurable.
 No official grade is assigned until configured.
*/

const fs = require("node:fs");

const CONFIG = {
  apiKey: process.env.YOUTUBE_API_KEY || "",

  step: Number(process.env.ENGINE_STEP || 3),

  event:
    process.env.WEATHER_EVENT ||
    "Hurricane Sandy",

  year: Number(
    process.env.WEATHER_YEAR || 2012
  ),

  location:
    process.env.WEATHER_LOCATION ||
    "New Jersey",

  minViews: Number(
    process.env.MIN_VIEWS || 1000
  ),

  minDocumentaryMinutes: Number(
    process.env.MIN_DOCUMENTARY_MINUTES || 20
  ),

  maxResults: Math.min(
    50,
    Math.max(
      1,
      Number(
        process.env.MAX_RESULTS_PER_QUERY || 50
      )
    )
  ),

  maxPages: Math.max(
    1,
    Number(
      process.env.MAX_PAGES_PER_QUERY || 1
    )
  ),

  maxSearchCalls: Math.max(
    1,
    Number(
      process.env.MAX_SEARCH_CALLS || 20
    )
  ),

  // Set these to your original grading thresholds
  // before enabling A-F grading.
  gradingThresholds: {
    A: null,
    B: null,
    C: null,
    D: null
  }
};

if (![3, 4].includes(CONFIG.step)) {
  throw new Error(
    "ENGINE_STEP must be 3 or 4"
  );
}

if (!CONFIG.apiKey) {
  throw new Error(
    "Missing YOUTUBE_API_KEY"
  );
}

const STEP_NAME =
  CONFIG.step === 3
    ? "YouTube News Coverage"
    : "YouTube Educational Documentaries";

const MIN_DURATION_SECONDS =
  CONFIG.step === 4
    ? CONFIG.minDocumentaryMinutes * 60
    : 0;

function clean(value) {
  return String(value || "")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&#x27;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function escapeRegex(value) {
  return String(value).replace(
    /[.*+?^${}()|[\]\\]/g,
    "\\$&"
  );
}

function hasPhrase(text, phrase) {
  const pattern = new RegExp(
    "(^|[^a-z0-9])" +
      escapeRegex(phrase.toLowerCase()) +
      "(?=$|[^a-z0-9])",
    "i"
  );

  return pattern.test(text);
}

function getEventTerms() {
  const event = CONFIG.event.toLowerCase();
  const terms = [event];

  if (event.includes("hurricane sandy")) {
    terms.push(
      "superstorm sandy",
      "sandy"
    );
  }

  return [...new Set(terms)];
}

function locationTerms() {
  const location = CONFIG.location.toLowerCase();

  const terms = [location];

  if (location === "new jersey") {
    terms.push(
      "nj",
      "n.j.",
      "jersey shore",
      "seaside heights",
      "seaside park",
      "atlantic city",
      "hoboken",
      "mantoloking",
      "belmar",
      "point pleasant",
      "asbury park",
      "long beach island",
      "union beach",
      "monmouth county",
      "ocean county",
      "brick township",
      "toms river",
      "keansburg",
      "sea bright",
      "highlands",
      "long branch",
      "ortley beach"
    );
  }

  return [...new Set(terms)];
}

function makeSearchQueries() {
  const e = CONFIG.event;
  const y = CONFIG.year;
  const l = CONFIG.location;

  if (CONFIG.step === 3) {
    return [
      `${e} ${y} ${l} news coverage`,
      `${e} ${y} ${l} breaking news`,
      `${e} ${y} ${l} live news report`,
      `${e} ${y} ${l} television news`,
      `${e} ${y} ${l} reporter footage`,
      `${e} ${y} ${l} storm news`
    ];
  }

  return [
    `${e} ${y} ${l} documentary`,
    `${e} ${y} documentary full`,
    `${e} ${l} educational documentary`,
    `${e} ${y} weather science documentary`,
    `${e} ${y} historical documentary`,
    `${e} ${l} storm analysis documentary`
  ];
}

async function api(endpoint, parameters) {
  const url = new URL(
    `https://www.googleapis.com/youtube/v3/${endpoint}`
  );

  for (const [key, value] of Object.entries(parameters)) {
    url.searchParams.set(
      key,
      String(value)
    );
  }

  url.searchParams.set(
    "key",
    CONFIG.apiKey
  );

  const response = await fetch(url);
  const data = await response.json();

  if (!response.ok) {
    throw new Error(
      data.error?.message ||
        `YouTube API HTTP ${response.status}`
    );
  }

  return data;
}

function parseDuration(iso) {
  if (!iso) return null;

  const match = String(iso).match(
    /^P(?:(\d+)D)?T?(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/
  );

  if (!match) return null;

  const days = Number(match[1] || 0);
  const hours = Number(match[2] || 0);
  const minutes = Number(match[3] || 0);
  const seconds = Number(match[4] || 0);

  return (
    days * 86400 +
    hours * 3600 +
    minutes * 60 +
    seconds
  );
}

function formatDuration(seconds) {
  if (seconds === null) {
    return "UNKNOWN";
  }

  const hours = Math.floor(
    seconds / 3600
  );

  const minutes = Math.floor(
    (seconds % 3600) / 60
  );

  const secs = seconds % 60;

  return [hours, minutes, secs]
    .map(value =>
      String(value).padStart(2, "0")
    )
    .join(":");
}

function assessRelevance(title, description) {
  const t = clean(title).toLowerCase();
  const d = clean(description).toLowerCase();
  const combined = `${t} ${d}`;

  const eventMatched = getEventTerms()
    .some(term => hasPhrase(combined, term));

  const locationMatched = locationTerms()
    .some(term => hasPhrase(combined, term));

  const yearMatched = hasPhrase(
    combined,
    String(CONFIG.year)
  );

  const weatherContext =
    /\b(hurricane|superstorm|storm|flood|flooding|surge|weather|wind|damage|aftermath|disaster)\b/i
      .test(combined);

  const newsTerms =
    /\b(news|coverage|report|reporter|broadcast|breaking|live|abc|nbc|cbs|cnn|fox|weather channel|press conference|newscast)\b/i;

  const educationTerms =
    /\b(documentary|educational|science|explained|analysis|history|historical|meteorology|investigation|in-depth|full episode|lecture|climate)\b/i;

  const newsMatched =
    newsTerms.test(combined);

  const educationMatched =
    educationTerms.test(combined);

  const eventRelevant =
    eventMatched && weatherContext;

  const categoryMatched =
    CONFIG.step === 3
      ? newsMatched
      : educationMatched;

  return {
    eventMatched,
    locationMatched,
    yearMatched,
    weatherContext,
    newsMatched,
    educationMatched,
    eventRelevant,
    categoryMatched,
    preliminaryRelevant:
      eventRelevant &&
      locationMatched &&
      categoryMatched
  };
}

function getGrade(count) {
  const t = CONFIG.gradingThresholds;

  const configured =
    ["A", "B", "C", "D"]
      .every(
        key =>
          Number.isInteger(t[key]) &&
          t[key] >= 0
      );

  if (!configured) {
    return {
      grade: "N/A",
      status: "AWAITING_ORIGINAL_GRADING_THRESHOLDS"
    };
  }

  if (!(t.A > t.B &&
        t.B > t.C &&
        t.C > t.D)) {
    return {
      grade: "N/A",
      status: "INVALID_GRADING_THRESHOLDS"
    };
  }

  let grade = "F";

  if (count >= t.A) grade = "A";
  else if (count >= t.B) grade = "B";
  else if (count >= t.C) grade = "C";
  else if (count >= t.D) grade = "D";

  return {
    grade,
    status: "PROVISIONAL_AUTOMATED_GRADE"
  };
}

function chunk(array, size) {
  const output = [];

  for (
    let i = 0;
    i < array.length;
    i += size
  ) {
    output.push(
      array.slice(i, i + size)
    );
  }

  return output;
}

async function discoverVideos() {
  const found = new Map();
  const searches = [];
  let calls = 0;

  for (const query of makeSearchQueries()) {
    let pageToken = "";

    for (
      let page = 0;
      page < CONFIG.maxPages &&
      calls < CONFIG.maxSearchCalls;
      page++
    ) {
      try {
        const parameters = {
          part: "snippet",
          type: "video",
          q: query,
          maxResults: CONFIG.maxResults,
          order: "relevance",
          regionCode: "US"
        };

        if (CONFIG.step === 4) {
          // Long = over 20 minutes according to
          // YouTube's search API.
          // Actual duration is verified later.
          parameters.videoDuration = "long";
        }

        if (pageToken) {
          parameters.pageToken = pageToken;
        }

        calls++;

        const result = await api(
          "search",
          parameters
        );

        const items = result.items || [];

        searches.push({
          query,
          page: page + 1,
          returned: items.length,
          status: "SUCCESS"
        });

        console.log(
          "SEARCH:",
          query,
          "PAGE:",
          page + 1,
          "RESULTS:",
          items.length
        );

        for (const item of items) {
          const id = item.id?.videoId;

          if (
            !id ||
            !/^[A-Za-z0-9_-]{11}$/.test(id)
          ) {
            continue;
          }

          if (!found.has(id)) {
            found.set(id, {
              id,
              queries: [query]
            });
          } else {
            const record = found.get(id);

            if (!record.queries.includes(query)) {
              record.queries.push(query);
            }
          }
        }

        pageToken =
          result.nextPageToken || "";

        if (!pageToken) break;

      } catch (error) {
        searches.push({
          query,
          page: page + 1,
          status: "FAILED",
          error: error.message
        });

        console.error(
          "SEARCH FAILED:",
          query,
          error.message
        );

        break;
      }
    }
  }

  return {
    found,
    searches,
    calls
  };
}

async function verifyVideos(found) {
  const verified = [];
  const belowViews = [];
  const tooShort = [];
  const needsReview = [];
  const unrelated = [];
  const unresolved = [];

  let detailCalls = 0;

  const ids = [...found.keys()];

  for (const group of chunk(ids, 50)) {
    const result = await api(
      "videos",
      {
        part:
          "snippet,statistics,contentDetails,status",
        id: group.join(",")
      }
    );

    detailCalls++;

    const returned = new Map(
      (result.items || []).map(
        item => [item.id, item]
      )
    );

    for (const id of group) {
      const item = returned.get(id);

      if (!item) {
        unresolved.push({
          id,
          reason: "VIDEO_NOT_RETURNED"
        });
        continue;
      }

      const title = clean(
        item.snippet?.title
      );

      const description = clean(
        item.snippet?.description
      );

      const viewsRaw =
        item.statistics?.viewCount;

      const views =
        viewsRaw !== undefined &&
        /^\d+$/.test(String(viewsRaw))
          ? Number(viewsRaw)
          : null;

      const durationSeconds =
        parseDuration(
          item.contentDetails?.duration
        );

      const relevance =
        assessRelevance(
          title,
          description
        );

      const record = {
        id,
        title,
        channel:
          item.snippet?.channelTitle || "",
        publishedAt:
          item.snippet?.publishedAt || null,
        views,
        durationSeconds,
        duration:
          formatDuration(durationSeconds),
        url:
          `https://www.youtube.com/watch?v=${id}`,
        matchedSearchQueries:
          found.get(id).queries,
        relevance,
        source:
          "YouTube Data API v3"
      };

      if (!relevance.eventRelevant) {
        unrelated.push({
          ...record,
          reason: "EVENT_NOT_ESTABLISHED"
        });
      } else if (!relevance.locationMatched ||
                 !relevance.categoryMatched) {
        needsReview.push({
          ...record,
          reason:
            !relevance.locationMatched
              ? "LOCATION_NOT_ESTABLISHED"
              : "CATEGORY_NOT_ESTABLISHED"
        });
      } else if (
        durationSeconds === null ||
        views === null
      ) {
        unresolved.push({
          ...record,
          reason:
            "METADATA_UNAVAILABLE"
        });
      } else if (
        CONFIG.step === 4 &&
        durationSeconds <
          MIN_DURATION_SECONDS
      ) {
        tooShort.push({
          ...record,
          reason:
            "BELOW_MINIMUM_DURATION"
        });
      } else if (
        views < CONFIG.minViews
      ) {
        belowViews.push({
          ...record,
          reason:
            "BELOW_MINIMUM_VIEWS"
        });
      } else {
        verified.push({
          ...record,
          status:
            "PRELIMINARY_QUALIFIED"
        });
      }
    }
  }

  verified.sort(
    (a, b) => b.views - a.views
  );

  return {
    verified,
    belowViews,
    tooShort,
    needsReview,
    unrelated,
    unresolved,
    detailCalls
  };
}

