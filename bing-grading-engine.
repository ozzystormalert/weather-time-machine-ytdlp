      category.terms;

    console.log(
      "\nSEARCH CATEGORY:",
      category.name
    );

    const record = {
      id: category.id,
      name: category.name,
      maximumPoints: category.weight,
      query,
      searchStatus: "NOT_EVALUATED",
      verificationStatus:
        "NOT_EVALUATED",
      score: null,
      grade: "Not Evaluated",
      results: []
    };

    if (KEY) {
      try {
        const response =
          await bingSearch(query);

        record.searchStatus =
          "COMPLETED";

        record.estimatedTotal =
          response.estimatedTotal;

        record.results =
          response.items.map(item => ({
            title: clean(item.name),
            url: item.url,
            snippet: clean(item.snippet),
            assessment:
              assessResource(item)
          }));

        record.preliminaryMatches =
          record.results.filter(
            item =>
              item.assessment.preliminaryMatch
          ).length;

        record.verificationStatus =
          "PENDING_MANUAL_REVIEW";

      } catch (error) {
        record.searchStatus = "FAILED";
        record.error = error.message;
      }
    }

    console.log(
      "SEARCH STATUS:",
      record.searchStatus
    );

    console.log(
      "PRELIMINARY MATCHES:",
      record.preliminaryMatches ?? "N/A"
    );

    console.log(
      "GRADE:",
      record.grade
    );

    result.categories.push(record);
  }

  const completed =
    result.categories.filter(
      category =>
        category.searchStatus ===
        "COMPLETED"
    ).length;

  const preliminary =
    result.categories.reduce(
      (total, category) =>
        total +
        (category.preliminaryMatches || 0),
      0
    );

  result.summary = {
    searchesRequested:
      CATEGORIES.length,

    searchesCompleted:
      completed,

    preliminaryMatches:
      preliminary,

    verifiedCategories: 0,

    score: null,

    grade: "Not Evaluated",

    gradingStatus:
      "AWAITING_VERIFIED_RESOURCES",

    note:
      "Bing discovery is not equivalent " +
      "to verified historical resources. " +
      "Manual verification is required."
  };

  fs.writeFileSync(
    "engine3-bing-grading-results.json",
    JSON.stringify(result, null, 2)
  );

  console.log(
    "\n======================================"
  );

  console.log(
    "BING GRADING TEST SUMMARY"
  );

  console.log(
    "======================================"
  );

  console.log(
    "SEARCHES COMPLETED:",
    completed,
    "/",
    CATEGORIES.length
  );

  console.log(
    "PRELIMINARY MATCHES:",
    preliminary
  );

  console.log(
    "OVERALL GRADE: Not Evaluated"
  );

  console.log(
    "REPORT:",
    "engine3-bing-grading-results.json"
  );

  console.log(
    "BLOGGER AND ENGINES 1/2 UNCHANGED."
  );

