function clean(value) {
  return String(value ?? "")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function normalize(value) {
  return clean(value).toLowerCase();
}

function escapeRegex(value) {
  return String(value)
    .replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function containsPhrase(text, phrase) {
  return new RegExp(
    "\\b" + escapeRegex(phrase) + "\\b",
    "i"
  ).test(text);
}

function assessResource(item) {
  const title = clean(item.name);
  const snippet = clean(item.snippet);

  const text = normalize(title + " " + snippet);

  const eventTokens = EVENT.toLowerCase()
    .split(/\s+/)
    .filter(token => token.length > 3);

  const eventMatch = eventTokens.every(
    token => containsPhrase(text, token)
  );

  const yearMatch = containsPhrase(text, YEAR);

  const locations = [
    LOCATION,
    "NJ",
    "Jersey Shore",
    "Seaside Heights",
    "Atlantic City",
    "Hoboken",
    "Belmar",
    "Mantoloking",
    "Toms River",
    "Asbury Park"
  ];

  const locationMatch = locations.some(
    place => containsPhrase(text, place)
  );

  const validUrl =
    /^https:\/\//i.test(item.url || "");

  const preliminaryMatch =
    eventMatch &&
    yearMatch &&
    locationMatch &&
    validUrl;

  return {
    eventMatch,
    yearMatch,
    locationMatch,
    validUrl,
    preliminaryMatch,
    verificationStatus:
      "NEEDS_MANUAL_VERIFICATION"
  };
}

// ORIGINAL GRADING PRINCIPLE:
// 100 points requires verified acceptable
// resources in all seven categories.
//
// These letter thresholds are provisional
// until original grading bands are confirmed.

function letterGrade(score, complete) {
  if (!complete || score === null) {
    return "Not Evaluated";
  }

  if (score === 100) return "A+";
  if (score >= 90) return "A";
  if (score >= 80) return "B";
  if (score >= 70) return "C";
  if (score >= 60) return "D";

  return "F";
}

// Search using an authorized Bing Web Search API.
// This endpoint requires valid API access.

async function bingSearch(query) {
  const url = new URL(ENDPOINT);

  url.searchParams.set("q", query);
  url.searchParams.set(
    "count",
    String(MAX_RESULTS)
  );
  url.searchParams.set("mkt", "en-US");
  url.searchParams.set(
    "responseFilter",
    "Webpages"
  );

  const controller = new AbortController();

  const timer = setTimeout(
    () => controller.abort(),
    20000
  );

  try {
    const response = await fetch(url, {
      headers: {
        "Ocp-Apim-Subscription-Key": KEY
      },
      signal: controller.signal
    });

    const raw = await response.text();

    let data;

    try {
      data = JSON.parse(raw);
    } catch {
      throw new Error(
        "Invalid API response. HTTP " +
        response.status
      );
    }

    if (!response.ok) {
      throw new Error(
        "Bing API HTTP " +
        response.status +
        ": " +
        (data.message ||
          data.error?.message ||
          "Unknown API error")
      );
    }

    if (
      !data.webPages ||
      !Array.isArray(data.webPages.value)
    ) {
      throw new Error(
        "Missing webPages results. " +
        "Search cannot be confirmed complete."
      );
    }

    return {
      items: data.webPages.value,
      estimatedTotal:
        data.webPages.totalEstimatedMatches ??
        null
    };
  } finally {
    clearTimeout(timer);
  }
}

async function main() {
